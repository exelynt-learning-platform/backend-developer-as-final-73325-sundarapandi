{
  "info": {
    "name": "Resource Booking System",
    "_postman_id": "b5f8b2b4-8a1d-4f9f-9b2e-booking-api",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {"key": "baseUrl", "value": "http://localhost:8080"},
    {"key": "token", "value": ""}
  ],
  "item": [
    {
      "name": "Login USER",
      "request": {
        "method": "POST",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "body": {"mode": "raw", "raw": "{\"username\":\"user\",\"password\":\"User@123\"}"},
        "url": {"raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api","auth","login"]}
      }
    },
    {
      "name": "List Resources",
      "request": {
        "method": "GET",
        "header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
        "url": {"raw": "{{baseUrl}}/api/resources", "host": ["{{baseUrl}}"], "path": ["api","resources"]}
      }
    },
    {
      "name": "Create Reservation",
      "request": {
        "method": "POST",
        "header": [
          {"key": "Authorization", "value": "Bearer {{token}}"},
          {"key": "Content-Type", "value": "application/json"}
        ],
        "body": {"mode": "raw", "raw": "{\"resourceId\":1,\"startTime\":\"2026-09-10T10:00:00\",\"endTime\":\"2026-09-10T12:00:00\",\"price\":500.00}"},
        "url": {"raw": "{{baseUrl}}/api/reservations", "host": ["{{baseUrl}}"], "path": ["api","reservations"]}
      }
    },
    {
      "name": "My Reservations",
      "request": {
        "method": "GET",
        "header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
        "url": {"raw": "{{baseUrl}}/api/reservations?page=0&size=10&sort=createdAt,desc", "host": ["{{baseUrl}}"], "path": ["api","reservations"], "query": [
          {"key": "page", "value": "0"}, {"key": "size", "value": "10"}, {"key": "sort", "value": "createdAt,desc"}
        ]}
      }
    }
  ]
}